// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" 
}

//  url      = env("DATABASE_URL")

// MODULO DE ESPECIALIDADES MÉDICAS

model Especialidad {
  id          Int      @id @default(autoincrement()) // Identificador unico de la especialidad [PK]
  nombre      String   @unique                       // Nombre único de la especialidad (Ej: Pediatria)
  descripcion String?                                // Descripcion opcional de la especialidad

  // Relacion: Una especialidad puede tener muchos médicos asignados
  medicos     Medico[]

  @@map("especialidades")
}

// MODULO DE MEDICOS

model Medico {
  id                 Int      @id @default(autoincrement()) // Identificador unico del medico [PK]
  documentoIdentidad String   @unique                       // Cédula o documento de identidad único
  nombre             String                                 // Nombre del medico
  apellido           String                                 // Apellido del medico
  correo             String   @unique                       // Correo electrónico institucional unico
  telefono           String                                 // Teléfono de contacto
  estado             Boolean  @default(true)                // Estado del medico (Activo: true, Inactivo: false)
  
  // Llave foranea hacia la especialidad
  especialidadId     Int                                    // ID de la especialidad [FK]
  especialidad       Especialidad @relation(fields: [especialidadId], references: [id])

  // Relaciones del medico con citas e historias clínicas
  citas              Cita[]
  historiasClinicas  HistoriaClinica[]

  @@map("medicos")
}


// MODULO DE PACIENTES

model Paciente {
  id                 Int      @id @default(autoincrement()) // Identificacion paciente [PK]
  documentoIdentidad String   @unique                       // Cédula o documento del paciente
  nombre             String                                 // Nombre del paciente
  apellido           String                                 // Apellido del paciente
  fechaNacimiento    DateTime                               // Fecha de nacimiento del paciente
  telefono           String                                 // Teléfono de contacto
  direccion          String                                 // Dirección de residencia (en Cali / Colombia)
  correo             String   @unique                       // Correo electrónico único

  // Relaciones del paciente
  citas              Cita[]
  historiasClinicas  HistoriaClinica[]

  @@map("pacientes")
}


// MODULO DE CITAS MÉDICAS

model Cita {
  id         Int      @id @default(autoincrement()) // Identificador unico de la cita [PK]
  fechaHora  DateTime                               // Fecha y hora programada para la cita
  estado     String   @default("PROGRAMADA")        // Estado actual (PROGRAMADA, ATENDIDA, CANCELADA)
  motivo     String                                 // Motivo de consulta manifestado por el paciente

  // Llaves foráneas
  pacienteId Int                                    // ID del paciente [FK]
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  medicoId   Int                                    // ID del médico [FK]
  medico     Medico   @relation(fields: [medicoId], references: [id])

  // Relaciones uno a uno con historia clínica y factura
  historiaClinica HistoriaClinica?
  factura         Factura?

  @@map("citas")
}


// MODULO DE HISTORIAS CLÍNICAS

model HistoriaClinica {
  id            Int      @id @default(autoincrement()) // Identificador unico de la historia [PK]
  fechaCreacion DateTime @default(now())               // Fecha de registro de la atención
  diagnostico   String                                 // Diagnóstico medico emitido
  tratamiento   String                                 // Tratamiento o medicamentos recetados
  observaciones String?                                // Notas u observaciones adicionales (opcional)

  // Llaves foraneas y relación uno a uno estricta con la Cita
  citaId        Int      @unique                       // ID de la cita asociada [FK] (Único 1:1)
  cita          Cita     @relation(fields: [citaId], references: [id])

  pacienteId    Int                                    // ID del paciente [FK]
  paciente      Paciente @relation(fields: [pacienteId], references: [id])

  medicoId      Int                                    // ID del medico que atiende [FK]
  medico        Medico   @relation(fields: [medicoId], references: [id])

  @@map("historias_clinicas")
}


// MODULO DE FACTURACIÓN

model Factura {
  id           Int      @id @default(autoincrement()) // Identificador unico de la factura [PK]
  fechaEmision DateTime @default(now())               // Fecha en que se emite la factura
  valorTotal   Decimal  @db.Decimal(10, 2)             // Valor monetario total a pagar (pesos colombianos)
  estado       String   @default("PENDIENTE")         // Estado de pago (PENDIENTE, PAGADA, ANULADA)

  // Llave foránea y relacion uno a uno con la Cita
  citaId       Int      @unique                       // ID de la cita facturada [FK] (Único 1:1)
  cita         Cita     @relation(fields: [citaId], references: [id])

  @@map("facturas")
}

model usuarios {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   // RECEPCIONISTA, MEDICO, GERENCIA
  createdAt DateTime @default(now())
}